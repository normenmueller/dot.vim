{
  // Interactive actions or information *above* the code.
  "codeLens.enable": true,
  "codeLens.display" : false,
  // Inline notes *in* the code (e.g. types).
  "inlayHint.enable": false,

  "outline.autoWidth": true,
  //"outline.splitCommand": "aboveleft 30vs",
  "outline.splitCommand": "botright 55vs",
  "outline.showLineNumber": false,

  "suggest.noselect": true,
  "suggest.autoTrigger": "none",

  // coc-explorer
  // https://github.com/weirongxu/coc-explorer
  //"explorer.file.showHiddenFiles": true,
  //"explorer.icon.enableNerdfont": true,
  //"explorer.width": 40,

  "languageserver": {

    "markdown": {
      "command": "marksman",
      "args": ["server"],
      "filetypes": ["markdown"],
      "rootPatterns": [".git/"],
      "initializationOptions": {}
    },

    "haskell": {
      "command": "haskell-language-server-wrapper",
       "args": ["--lsp"],
       "filetypes": ["haskell", "lhaskell"],
       "rootPatterns": ["*.cabal", "cabal.project", "hie.yaml"],
       "settings": {
         "haskell": {
           "checkProject": true,
           "checkParents": "CheckOnSave",
           "maxCompletions": 40,
           "plugin": {
             // Enable hlint diagnostics & suggestions
             "hlint": {
               "codeActionsOn": true,
               "diagnosticsOn": true
             },
             // Disable stan (static analysis engine)
             "stan": { "globalOn": false }
           }
         }
       }
    }
  }
}

