{
    "languageserver": {
        "markdown": {
            "command": "marksman",
            "args": ["server"],
            "filetypes": ["markdown"],
            "rootPatterns": [".git/"],
            "initializationOptions": {}
        },
        "haskell": {
            "command": "haskell-language-server-wrapper",
            "args": ["--lsp"],
            "rootPatterns": ["*.cabal", "cabal.project", "hie.yaml"],
            "filetypes": ["haskell", "lhaskell"],
            "settings": {
                "haskell": {
                    "checkParents": "CheckOnSave",
                    "checkProject": true,
                    "maxCompletions": 40,
                    "plugin": {
                        "hlint": {
                            "codeActionsOn": true,
                            "diagnosticsOn": true
                        },
                        "stan": {
                            "globalOn": false
                        },
                        "importLens": {
                            "globalOn": false
                        },
                        "codeRange": {
                            "globalOn": true
                        },
                        "ghcide-type-lenses": {
                            "globalOn": true
                        }
                    }
                }
            }
        }
    }
}
