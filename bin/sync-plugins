#!/bin/sh
set -u

cd "$(dirname "$0")/.." || exit 1

if [ "$#" -gt 1 ]; then
  echo "Usage: $0 [PROFILE]" >&2
  exit 2
fi

if [ "$#" -eq 1 ]; then
  case "$1" in
    ''|*[!a-z0-9_-]*)
      echo "Invalid Vim profile name: $1" >&2
      exit 2
      ;;
  esac
  if [ ! -f "$PWD/profiles/$1.vim" ]; then
    echo "Unknown Vim profile: $1" >&2
    exit 2
  fi
  VIM_PROFILE=$1
  export VIM_PROFILE
fi

status_file=$(mktemp /tmp/dot-vim-plugstatus.XXXXXX) || exit 1
trap 'rm -f "$status_file"' EXIT HUP INT TERM
DOT_VIM_SYNC_STATUS_FILE=$status_file
export DOT_VIM_SYNC_STATUS_FILE

run_plug_command() {
  : > "$status_file" || return 1
  command_result=0
  # A :try wrapper turns vim-plug's cosmetic Ex errors into exceptions and
  # aborts its command before the completion output can be produced.
  vim -i NONE -Nu "$PWD/vimrc" -n -es \
    +"$1" \
    +'call writefile(getline(1, "$"), $DOT_VIM_SYNC_STATUS_FILE)' \
    +'qa!' || command_result=$?

  sed -n '1,160p' "$status_file"

  # vim-plug may return a cosmetic nonzero status. Require its completion
  # marker and reject plugin/hook errors before trusting the result.
  if grep -Eq "$2" "$status_file" \
      && ! grep -q '^x ' "$status_file"; then
    return 0
  fi

  echo "$1 did not complete successfully (Vim exit status: $command_result)." >&2
  return 1
}

verify_plugins() {
  : > "$status_file" || return 1
  status_result=0
  vim -i NONE -Nu "$PWD/vimrc" -n -es \
    +'PlugStatus' \
    +'call writefile(getline(1, "$"), $DOT_VIM_SYNC_STATUS_FILE)' \
    +'qa!' || status_result=$?

  sed -n '1,160p' "$status_file"

  artifacts_result=0
  if [ ! -s plugged/coc.nvim/build/index.js ]; then
    echo "Missing CoC build artifact: plugged/coc.nvim/build/index.js" >&2
    artifacts_result=1
  fi
  if [ ! -x plugged/fzf/bin/fzf ]; then
    echo "Missing fzf executable: plugged/fzf/bin/fzf" >&2
    artifacts_result=1
  fi

  [ "$status_result" -eq 0 ] \
    && [ "$artifacts_result" -eq 0 ] \
    && grep -Fxq 'Finished. 0 error(s).' "$status_file"
}

if ! run_plug_command 'PlugInstall --sync' '^Updated\.'; then
  echo "Installation failed; plugin cleanup skipped." >&2
  exit 1
fi

if ! verify_plugins; then
  echo "Plugin verification failed; plugin cleanup skipped." >&2
  exit 1
fi

if ! run_plug_command 'PlugClean!' '^(Already clean\.|Removed [0-9]+ directories\.)$'; then
  echo "Plugin cleanup failed for profile: ${VIM_PROFILE:-local selection}" >&2
  exit 1
fi

if ! verify_plugins; then
  echo "Plugin verification failed after cleanup for profile: ${VIM_PROFILE:-local selection}" >&2
  exit 1
fi
